{
  "model": "Qwen/Qwen3-0.6B",
  "seed": 6304,
  "num_examples": 40000,
  "effective_batch": 32,
  "micro_batch": 2,
  "max_len": 2048,
  "updates": 1250,
  "warmup": 38,
  "optimizer": {
    "name": "AdamW",
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08,
    "weight_decay": 0.01,
    "decay_rule": "tensors with 2 or more dims"
  },
  "schedule": "cosine with linear warmup",
  "grad_clip_norm": 1.0,
  "grad_scaler_init_scale": 2048,
  "precision": "frozen fp16 backbone, fp32 adapters and optimizer state, fp16 autocast on cuda",
  "lora": {
    "dropout_on_input": 0.05,
    "targets": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ],
    "a_init": "uniform in +-1/sqrt(in_features)",
    "b_init": "zeros"
  },
  "protect_k": 128,
  "recovery_steps": [
    312,
    625,
    937,
    1250
  ],
  "run_order": [
    "lora16",
    "oplora16",
    "lora4"
  ],
  "runs": {
    "lora16": {
      "method": "lora",
      "rank": 16,
      "alpha": 32,
      "peak_lr": 0.0002
    },
    "oplora16": {
      "method": "oplora",
      "rank": 16,
      "alpha": 32,
      "peak_lr": 0.0002
    },
    "lora4": {
      "method": "lora",
      "rank": 4,
      "alpha": 8,
      "peak_lr": 0.0002
    }
  },
  "gpus": [
    0,
    1
  ],
  "cuda": true,
  "versions": {
    "torch": "2.11.0+cu128",
    "transformers": "5.16.1",
    "datasets": "4.8.5",
    "numpy": "2.1.3"
  },
  "python": "3.13.15"
}